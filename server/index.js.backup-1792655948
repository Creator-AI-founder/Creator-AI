function runCommand(command, args) {
  return new Promise((resolve, reject) => {
    execFile(command, args, (error, stdout, stderr) => {
      if (error) {
        console.error(stderr);
        reject(error);
        return;
      }

      resolve(stdout);
    });
  });
}

/*
  Select eSpeak voice based on Creator AI language.
*/
function getVoice(language) {
  const lang = String(language || "English").toLowerCase();

  if (lang === "hindi") {
    return "hi";
  }

  if (
    lang === "bangla" ||
    lang === "bengali"
  ) {
    return "bn";
  }

  if (lang === "banglish") {
    // Banglish uses English pronunciation because
    // the text is normally written with English letters.
    return "en-us";
  }

  // Default
  return "en-us";
}


async function createVoice(text, output, language) {
  if (!text || !text.trim()) {
    throw new Error("No voiceover text provided.");
  }

  const lang = String(language || "English").toLowerCase();

  let kokoroLang = "en-us";
  let voice = "af_heart";

  if (lang === "hindi") {
    kokoroLang = "hi";
    voice = "hf_alpha";
  } else if (lang === "bangla" || lang === "bengali") {
    kokoroLang = "en-us";
    voice = "af_heart";
  } else if (lang === "banglish") {
    kokoroLang = "en-us";
    voice = "af_heart";
  }

  const ryk =
    "/data/data/com.termux/files/home/creator-ai/server/kukuryku/target/release/ryk";

  const assetDir =
    "/data/data/com.termux/files/home/creator-ai/server/kukuryku/kokoro-onyx";

  console.log(`Voice language: ${language} → Kokoro voice: ${voice}`);

  await runCommand("env", [
    `KUKURYKU_ASSET_DIR=${assetDir}`,
    `KOKORO_LANG=${kokoroLang}`,
    `KOKORO_VOICE=${voice}`,
    "KOKORO_NO_PLAY=1",
    `KOKORO_WAV=${output}`,
    ryk,
    text
  ]);

  return output;
}

async function fetchWebImage(query, output) {
  console.log(`Searching free image: ${query}`);

  try {
    const search = await axios.get(
      "https://commons.wikimedia.org/w/api.php",
      {
        params: {
          action: "query",
          generator: "search",
          gsrsearch: query,
          gsrnamespace: 6,
          gsrlimit: 30,
          prop: "imageinfo",
          iiprop: "url|mime",
          format: "json",
          origin: "*"
        },
        headers: {
          "User-Agent": "CreatorAI/1.0"
        },
        timeout: 30000
      }
    );

    const pages = Object.values(search.data?.query?.pages || {});

    const imagePage = pages.find(p => {
      const info = p.imageinfo?.[0];
      if (!info || !info.url) return false;

      const mime = String(info.mime || "").toLowerCase();

      return (
        mime === "image/jpeg" ||
        mime === "image/png" ||
        mime === "image/webp"
      );
    });

    if (imagePage) {
      const info = imagePage.imageinfo[0];

      console.log(`Using Wikimedia image: ${imagePage.title}`);

      const response = await axios.get(info.url, {
        responseType: "arraybuffer",
        headers: {
          "User-Agent": "CreatorAI/1.0"
        },
        timeout: 30000
      });

      fs.writeFileSync(output, Buffer.from(response.data));
      return output;
    }

    console.log("No suitable Wikimedia image. Using fallback.");
  } catch (error) {
    console.log("Wikimedia search failed. Using fallback.");
  }

  // Local fallback: use an existing test asset instead of another
  // external image service.
  const fallbackCandidates = [
    path.join(testAssets, "scene1.jpg"),
    path.join(testAssets, "scene2.jpg"),
    path.join(testAssets, "scene3.jpg")
  ];

  const fallback = fallbackCandidates.find(file =>
    fs.existsSync(file)
  );

  if (!fallback) {
    throw new Error("No usable web image and no local fallback image exists.");
  }

  fs.copyFileSync(fallback, output);

  console.log(`Using local fallback visual: ${fallback}`);

  return output;
}
async function generateDirector({
  idea,
  duration,
  style,
  language
}) {
  const response = await fetch(
    "https://openrouter.ai/api/v1/chat/completions",
    {
      method: "POST",

      headers: {
        "Authorization":
          `Bearer ${process.env.OPENROUTER_API_KEY}`,

        "Content-Type":
          "application/json"
      },

      body: JSON.stringify({
        model: "openrouter/free",

        messages: [
          {
            role: "system",

            content: `
You are Creator AI, an expert short-form video director.

Create original, engaging and creator-ready YouTube Shorts.

Return ONLY valid JSON.
Do not use markdown.
Do not put JSON inside code fences.

Use exactly this structure:

{
  "title": "short title",
  "hook": "powerful opening hook",
  "voiceover": "complete voiceover narration",
  "scenes": [
    {
      "scene": 1,
      "visual": "what should appear on screen",
      "voiceover": "voiceover for this scene",
      "caption": "short on-screen caption"
    }
  ],
  "music": "music and sound effect direction"
}

IMPORTANT:

The selected language is ${language}.

Write the entire voiceover in the selected language.

If the language is Hindi:
- Write natural Hindi.
- Use Devanagari script.
- Do not write Hindi using Chinese characters.
- Do not randomly switch to another language.

If the language is Bangla:
- Write natural Bengali.
- Use Bengali script.

If the language is Banglish:
- Write Bangla using English/Roman letters.

If the language is English:
- Write natural English.

Make the narration appropriate for the requested duration.

Create enough scenes to make the Short visually interesting.

Never guarantee that a video will go viral.
`
          },

          {
            role: "user",

            content: `
Create a ${duration} ${style} YouTube Short.

Language:
${language}

Idea:
${idea}
`
          }
        ],

        temperature: 0.8
      })
    }
  );

  const data = await response.json();

  if (!response.ok) {
    console.error(data);

    throw new Error(
      data.error?.message ||
      "AI request failed."
    );
  }

  const raw =
    data.choices?.[0]?.message?.content;

  if (!raw) {
    throw new Error(
      "AI returned an empty response."
    );
  }

  let result;

  try {
    result = JSON.parse(raw);
  } catch (error) {
    console.error(
      "Invalid JSON from AI:",
      raw
    );

    throw new Error(
      "AI returned an invalid format. Try again."
    );
  }

  return result;
}


