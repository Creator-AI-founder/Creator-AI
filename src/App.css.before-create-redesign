* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --bg: #07070a;
  --panel: #101014;
  --panel-2: #0c0c10;
  --panel-3: #15151b;
  --border: rgba(255,255,255,.08);
  --border-hover: rgba(255,255,255,.14);
  --text: #f5f5f7;
  --muted: #92929d;
  --muted-2: #666671;
  --purple: #9b7cff;
  --purple-dark: #714cff;
  --green: #52d98b;
  --danger: #ff6878;
}

html,
body,
#root {
  margin: 0;
  width: 100%;
  min-height: 100%;
}

body {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  background: var(--bg);
  color: var(--text);
}

button,
textarea,
select {
  font: inherit;
}

button {
  border: 0;
}

button,
select {
  -webkit-tap-highlight-color: transparent;
}

.app-shell {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at 75% 5%, rgba(123,79,255,.10), transparent 28%),
    radial-gradient(circle at 20% 80%, rgba(87,52,180,.06), transparent 30%),
    var(--bg);
}

/* SIDEBAR */

.sidebar {
  width: 238px;
  min-height: 100vh;
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  padding: 20px 14px;
  border-right: 1px solid var(--border);
  background: rgba(9,9,12,.92);
  backdrop-filter: blur(22px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 10px 25px;
}

.brand-mark {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  color: white;
  font-size: 17px;
  font-weight: 800;
  background: linear-gradient(135deg, #a98cff, #704bff);
  box-shadow: 0 8px 25px rgba(122,78,255,.3);
}

.brand strong {
  font-size: 16px;
  letter-spacing: -.02em;
}

.brand span {
  color: var(--muted);
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px 12px;
  border-radius: 10px;
  color: var(--muted);
  background: transparent;
  cursor: pointer;
  text-align: left;
  transition: .18s ease;
}

.nav-item:hover {
  color: var(--text);
  background: rgba(255,255,255,.045);
}

.nav-item.active {
  color: white;
  background: rgba(148,116,255,.13);
}

.nav-icon {
  width: 18px;
  text-align: center;
  font-size: 15px;
}

.nav-label {
  font-size: 13px;
  font-weight: 600;
}

.sidebar-bottom {
  margin-top: auto;
}

.plan-card {
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: linear-gradient(145deg, rgba(155,124,255,.12), rgba(255,255,255,.025));
}

.plan-icon {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  margin-bottom: 10px;
  background: rgba(155,124,255,.14);
}

.plan-card strong {
  display: block;
  font-size: 13px;
}

.plan-card p {
  margin: 5px 0 12px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

.plan-card button {
  width: 100%;
  padding: 8px;
  border-radius: 8px;
  color: white;
  background: linear-gradient(135deg, #9b7cff, #714cff);
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.user-card {
  margin-top: 12px;
  padding: 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid var(--border);
}

.avatar {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #27272e;
  font-size: 12px;
  font-weight: 700;
}

.user-card div:nth-child(2) {
  min-width: 0;
  flex: 1;
}

.user-card strong {
  display: block;
  font-size: 12px;
}

.user-card span {
  color: var(--muted-2);
  font-size: 10px;
}

.dots {
  color: var(--muted);
  background: transparent;
}

/* MAIN */

.main-content {
  width: calc(100% - 238px);
  margin-left: 238px;
  min-height: 100vh;
}

.topbar {
  height: 68px;
  padding: 0 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  background: rgba(7,7,10,.65);
  backdrop-filter: blur(20px);
  position: sticky;
  top: 0;
  z-index: 10;
}

.mobile-brand {
  display: none;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 10px rgba(82,217,139,.6);
}

.status-text {
  color: var(--muted);
  font-size: 11px;
}

.icon-button {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 9px;
  color: var(--muted);
  background: rgba(255,255,255,.025);
  cursor: pointer;
}

.page {
  width: min(1180px, calc(100% - 60px));
  margin: 0 auto;
  padding: 52px 0 100px;
}

/* HERO */

.hero {
  max-width: 720px;
  margin-bottom: 38px;
}

.eyebrow,
.card-eyebrow {
  color: var(--purple);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .13em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 12px 0 13px;
  font-size: clamp(38px, 5vw, 64px);
  line-height: .98;
  letter-spacing: -.055em;
}

.hero h1 span {
  color: var(--purple);
}

.hero p {
  max-width: 570px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.7;
}

/* CREATOR */

.creator-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(280px, .8fr);
  gap: 18px;
  align-items: start;
}

.create-card,
.director-card,
.result-card,
.project-card,
.settings-card {
  border: 1px solid var(--border);
  border-radius: 18px;
  background:
    linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.018)),
    rgba(13,13,17,.9);
  box-shadow: 0 20px 70px rgba(0,0,0,.22);
}

.create-card {
  padding: 22px;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.card-eyebrow {
  color: var(--muted);
  letter-spacing: .08em;
}

.draft-badge {
  padding: 5px 8px;
  border-radius: 6px;
  color: var(--muted);
  background: rgba(255,255,255,.045);
  font-size: 10px;
}

.idea-box {
  width: 100%;
  min-height: 170px;
  resize: vertical;
  outline: none;
  padding: 17px;
  border: 1px solid var(--border);
  border-radius: 13px;
  color: var(--text);
  background: rgba(0,0,0,.22);
  font-size: 14px;
  line-height: 1.6;
  transition: .18s ease;
}

.idea-box::placeholder {
  color: var(--muted-2);
}

.idea-box:focus {
  border-color: rgba(155,124,255,.55);
  box-shadow: 0 0 0 3px rgba(155,124,255,.08);
}

.idea-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 7px;
  color: var(--muted-2);
  font-size: 10px;
}

.spark-button {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  color: #bcaaff;
  background: rgba(155,124,255,.10);
  cursor: pointer;
}

.options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 17px;
}

.option-group label {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.option-group select {
  width: 100%;
  height: 42px;
  padding: 0 11px;
  outline: none;
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  background: #111116;
  cursor: pointer;
}

.option-group select:focus {
  border-color: rgba(155,124,255,.5);
}

.button-row {
  display: flex;
  gap: 9px;
  margin-top: 18px;
}

.primary-button,
.secondary-button {
  min-height: 43px;
  padding: 0 17px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 750;
  cursor: pointer;
  transition: .18s ease;
}

.primary-button {
  flex: 1;
  color: white;
  background: linear-gradient(135deg, #a98cff, #714cff);
  box-shadow: 0 10px 30px rgba(113,76,255,.22);
}

.primary-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 13px 35px rgba(113,76,255,.3);
}

.secondary-button {
  color: #ddd9ef;
  border: 1px solid var(--border);
  background: rgba(255,255,255,.035);
}

.secondary-button:hover {
  background: rgba(255,255,255,.07);
  border-color: var(--border-hover);
}

button:disabled {
  opacity: .55;
  cursor: not-allowed;
  transform: none !important;
}

/* DIRECTOR */

.director-card {
  padding: 20px;
}

.director-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

.director-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: rgba(155,124,255,.12);
  color: #bcaaff;
}

.director-header strong {
  display: block;
  font-size: 13px;
}

.director-header span {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 10px;
}

.director-empty {
  padding: 28px 10px;
  color: var(--muted-2);
  font-size: 11px;
  line-height: 1.6;
  text-align: center;
}

.director-list {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.director-block {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: rgba(255,255,255,.018);
}

.director-block label {
  display: block;
  margin-bottom: 5px;
  color: var(--muted-2);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.director-block p {
  margin: 0;
  color: #dddde2;
  font-size: 11px;
  line-height: 1.55;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 8px;
}

.scene-item {
  display: flex;
  gap: 8px;
  color: #c5c5cb;
  font-size: 10px;
  line-height: 1.45;
}

.scene-number {
  color: var(--purple);
  font-weight: 800;
}

/* LOADING */

.loading-card {
  margin-top: 18px;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(255,255,255,.025);
}

.loading-title {
  font-size: 13px;
  font-weight: 700;
}

.loading-subtitle {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

.loading-bar {
  height: 4px;
  margin-top: 15px;
  overflow: hidden;
  border-radius: 99px;
  background: rgba(255,255,255,.07);
}

.loading-bar span {
  display: block;
  width: 40%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #714cff, #c0adff);
  animation: loading 1.2s infinite ease-in-out;
}

@keyframes loading {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(320%); }
}

/* RESULTS */

.results {
  margin-top: 55px;
}

.results-title {
  margin-bottom: 18px;
}

.results-title h2 {
  margin: 5px 0;
  font-size: 25px;
  letter-spacing: -.035em;
}

.results-title p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.result-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr);
  gap: 16px;
}

.result-card {
  overflow: hidden;
}

.video-wrap {
  aspect-ratio: 9 / 16;
  max-height: 680px;
  background: #030304;
}

.video-wrap video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
}

.result-info {
  padding: 16px;
}

.result-info h3 {
  margin: 0 0 5px;
  font-size: 13px;
}

.result-info p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

.download-button {
  display: inline-flex;
  margin-top: 13px;
  padding: 9px 12px;
  border-radius: 8px;
  color: white;
  background: rgba(155,124,255,.14);
  font-size: 11px;
  text-decoration: none;
}

.error-box {
  margin-top: 16px;
  padding: 12px;
  border: 1px solid rgba(255,104,120,.2);
  border-radius: 10px;
  color: #ff9ba7;
  background: rgba(255,104,120,.05);
  font-size: 11px;
}

/* FEATURES */

.features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 20px;
}

.feature {
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(255,255,255,.018);
}

.feature strong {
  display: block;
  margin-bottom: 5px;
  font-size: 11px;
}

.feature span {
  color: var(--muted);
  font-size: 10px;
  line-height: 1.45;
}

/* PROJECTS */

.page-title {
  margin-bottom: 25px;
}

.page-title h1 {
  margin: 8px 0;
  font-size: 34px;
  letter-spacing: -.045em;
}

.page-title p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.project-card {
  padding: 17px;
  min-height: 130px;
}

.project-thumb {
  height: 95px;
  margin-bottom: 13px;
  border-radius: 10px;
  background:
    linear-gradient(135deg, rgba(155,124,255,.2), rgba(80,50,160,.06)),
    #111116;
}

.project-card strong {
  font-size: 12px;
}

.project-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 6px;
  color: var(--muted);
  font-size: 10px;
}

/* SETTINGS */

.settings-card {
  max-width: 720px;
  overflow: hidden;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px;
  border-bottom: 1px solid var(--border);
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-row strong {
  display: block;
  font-size: 12px;
}

.setting-row p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 10px;
}

.setting-control {
  min-width: 150px;
  padding: 9px;
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  background: #111116;
}

/* MOBILE NAV */

.mobile-nav {
  display: none;
}

/* RESPONSIVE */

@media (max-width: 950px) {
  .sidebar {
    width: 205px;
  }

  .main-content {
    width: calc(100% - 205px);
    margin-left: 205px;
  }

  .page {
    width: calc(100% - 34px);
  }

  .creator-layout,
  .result-grid {
    grid-template-columns: 1fr;
  }

  .director-card {
    order: 2;
  }

  .features {
    grid-template-columns: repeat(2, 1fr);
  }

  .projects-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .sidebar {
    display: none;
  }

  .main-content {
    width: 100%;
    margin-left: 0;
    padding-bottom: 72px;
  }

  .topbar {
    height: 58px;
    padding: 0 16px;
  }

  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mobile-brand .brand-mark {
    width: 27px;
    height: 27px;
    border-radius: 8px;
    font-size: 14px;
  }

  .mobile-brand strong {
    font-size: 13px;
  }

  .status-text {
    display: none;
  }

  .page {
    width: calc(100% - 24px);
    padding: 34px 0 35px;
  }

  .hero {
    margin-bottom: 25px;
  }

  .hero h1 {
    font-size: 40px;
  }

  .hero p {
    font-size: 13px;
  }

  .create-card,
  .director-card {
    padding: 15px;
    border-radius: 14px;
  }

  .idea-box {
    min-height: 145px;
  }

  .options {
    grid-template-columns: 1fr;
  }

  .button-row {
    flex-direction: column;
  }

  .features {
    grid-template-columns: 1fr 1fr;
  }

  .projects-grid {
    grid-template-columns: 1fr;
  }

  .result-grid {
    grid-template-columns: 1fr;
  }

  .video-wrap {
    max-height: 620px;
  }

  .mobile-nav {
    position: fixed;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    left: 10px;
    right: 10px;
    bottom: 10px;
    z-index: 30;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: rgba(14,14,18,.9);
    backdrop-filter: blur(20px);
    box-shadow: 0 15px 45px rgba(0,0,0,.45);
  }

  .mobile-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 8px 4px;
    border-radius: 10px;
    color: var(--muted);
    background: transparent;
    font-size: 9px;
    cursor: pointer;
  }

  .mobile-nav-item.active {
    color: white;
    background: rgba(155,124,255,.12);
  }
}

@media (max-width: 430px) {
  .hero h1 {
    font-size: 34px;
  }

  .features {
    grid-template-columns: 1fr;
  }

  .page-title h1 {
    font-size: 29px;
  }
}
