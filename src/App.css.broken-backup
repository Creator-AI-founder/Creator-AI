* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  width: 100%;
  min-height: 100%;
}

:root {
  color-scheme: dark;
  --bg: #060608;
  --panel: rgba(17, 17, 21, 0.82);
  --panel-2: rgba(12, 12, 16, 0.9);
  --border: rgba(255, 255, 255, 0.08);
  --border-soft: rgba(255, 255, 255, 0.055);
  --text: #f7f7f8;
  --muted: #85858f;
  --muted-2: #5f5f69;
  --purple: #9b7cff;
  --purple-2: #714cff;
}

body {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background:
    radial-gradient(
      700px 420px at 50% -100px,
      rgba(125, 92, 255, 0.2),
      transparent 70%
    ),
    radial-gradient(
      500px 400px at 100% 35%,
      rgba(87, 55, 180, 0.08),
      transparent 70%
    ),
    var(--bg);

  color: var(--text);
  overflow-x: hidden;
}

button,
textarea,
select {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.app {
  min-height: 100vh;
}

/* =========================
   NAVBAR
========================= */

.navbar {
  height: 66px;
  padding: 0 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  position: sticky;
  top: 0;
  z-index: 100;

  background: rgba(6, 6, 8, 0.72);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);

  border-bottom: 1px solid rgba(255, 255, 255, 0.055);
}

.logo {
  display: flex;
  align-items: center;
  gap: 9px;

  font-size: 18px;
  font-weight: 850;
  letter-spacing: -0.7px;
}

.logo span {
  width: 27px;
  height: 27px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 8px;

  background: linear-gradient(
    135deg,
    #a78bfa,
    #6941ff
  );

  color: white;
  font-size: 14px;

  box-shadow:
    0 6px 20px rgba(124, 58, 237, 0.3);
}

.proButton {
  padding: 7px 13px;

  border: 1px solid rgba(167, 139, 250, 0.28);
  border-radius: 999px;

  background: rgba(139, 92, 246, 0.08);

  color: #c8baff;

  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

/* =========================
   MAIN
========================= */

.container {
  width: min(calc(100% - 34px), 980px);

  margin: auto;

  padding: 62px 0 80px;
}

/* =========================
   HERO
========================= */

.hero {
  max-width: 760px;

  margin: 0 auto 38px;

  text-align: center;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 7px 12px;

  margin-bottom: 19px;

  border: 1px solid rgba(167, 139, 250, 0.2);
  border-radius: 999px;

  background:
    linear-gradient(
      180deg,
      rgba(139, 92, 246, 0.12),
      rgba(139, 92, 246, 0.04)
    );

  color: #bcaeff;

  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.35px;
}

.hero h1 {
  margin: 0;

  font-size: clamp(42px, 7vw, 76px);

  line-height: 0.98;

  letter-spacing: -4px;

  font-weight: 850;
}

.hero h1 span {
  display: block;

  margin-top: 8px;

  background:
    linear-gradient(
      100deg,
      #ffffff 0%,
      #bca9ff 45%,
      #7857ff 100%
    );

  background-clip: text;
  -webkit-background-clip: text;

  color: transparent;
}

.hero p {
  max-width: 570px;

  margin: 20px auto 0;

  color: #85858f;

  font-size: 14px;
  line-height: 1.7;
}

/* =========================
   CREATOR PANEL
========================= */

.creatorCard {
  position: relative;

  width: 100%;

  padding: 24px;

  background:
    linear-gradient(
      145deg,
      rgba(24, 24, 30, 0.95),
      rgba(11, 11, 15, 0.96)
    );

  border: 1px solid var(--border);

  border-radius: 25px;

  box-shadow:
    0 30px 100px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);

  overflow: hidden;
}

.creatorCard::before {
  content: "";

  position: absolute;

  width: 280px;
  height: 180px;

  top: -140px;
  left: 50%;

  transform: translateX(-50%);

  background: rgba(126, 87, 255, 0.2);

  filter: blur(80px);

  pointer-events: none;
}

.cardTop {
  position: relative;

  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 18px;
}

.smallLabel {
  color: #9276ff;

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 1.4px;
}

.cardTop h2,
.workspaceHeader h2 {
  margin: 5px 0 0;

  font-size: 21px;

  font-weight: 800;

  letter-spacing: -0.7px;
}

.status {
  display: flex;
  align-items: center;
  gap: 6px;

  flex-shrink: 0;

  padding-top: 4px;

  color: #79e6a4;

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 0.8px;
}

textarea {
  position: relative;

  display: block;

  width: 100%;
  min-height: 165px;

  padding: 17px;

  resize: vertical;

  outline: none;

  border: 1px solid rgba(255, 255, 255, 0.075);

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(7, 7, 10, 0.96),
      rgba(12, 12, 16, 0.92)
    );

  color: #f5f5f6;

  font-size: 15px;
  line-height: 1.6;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

textarea::placeholder {
  color: #55555f;
}

textarea:focus {
  border-color: rgba(155, 124, 255, 0.6);

  box-shadow:
    0 0 0 3px rgba(124, 58, 237, 0.08),
    0 12px 40px rgba(0, 0, 0, 0.15);
}

/* =========================
   OPTIONS
========================= */

.options {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 12px;

  margin-top: 14px;
}

.option {
  min-width: 0;
}

.option label {
  display: block;

  margin: 0 0 7px 2px;

  color: #72727d;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.9px;

  text-transform: uppercase;
}

select {
  width: 100%;
  height: 47px;

  padding: 0 13px;

  outline: none;

  border: 1px solid rgba(255, 255, 255, 0.07);

  border-radius: 13px;

  background: rgba(7, 7, 10, 0.9);

  color: #e7e7ea;

  font-size: 13px;

  cursor: pointer;

  transition:
    border-color 0.2s ease,
    background 0.2s ease;
}

select:focus,
select:hover {
  border-color: rgba(155, 124, 255, 0.4);
  background: rgba(18, 17, 24, 0.95);
}

/* =========================
   BUTTONS
========================= */

.buttonRow {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 10px;

  margin-top: 17px;
}

.createButton,
.videoButton {
  min-height: 55px;

  border-radius: 15px;

  font-size: 14px;
  font-weight: 800;

  cursor: pointer;

  transition:
    transform 0.16s ease,
    opacity 0.16s ease,
    border-color 0.16s ease,
    box-shadow 0.16s ease;
}

.createButton {
  border: 0;

  background:
    linear-gradient(
      135deg,
      #9c7cff,
      #6843ed
    );

  color: white;

  box-shadow:
    0 15px 35px rgba(104, 67, 237, 0.25);
}

.videoButton {
  border: 1px solid rgba(155, 124, 255, 0.25);

  background:
    linear-gradient(
      180deg,
      rgba(139, 92, 246, 0.13),
      rgba(139, 92, 246, 0.06)
    );

  color: #ddd6fe;
}

.createButton:hover,
.videoButton:hover {
  transform: translateY(-1px);
}

.createButton:active,
.videoButton:active {
  transform: scale(0.985);
}

.createButton:disabled,
.videoButton:disabled {
  opacity: 0.55;
  cursor: wait;
}

.freeText {
  margin-top: 12px;

  text-align: center;

  color: #555560;

  font-size: 10px;
}

/* =========================
   LOADING
========================= */

.loadingCard {
  display: flex;
  align-items: center;

  gap: 14px;

  margin-top: 17px;
  padding: 17px 18px;

  background: rgba(15, 15, 20, 0.9);

  border: 1px solid rgba(155, 124, 255, 0.15);

  border-radius: 17px;

  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.18);
}

.loader {
  width: 28px;
  height: 28px;

  flex-shrink: 0;

  border: 3px solid rgba(167, 139, 250, 0.12);

  border-top-color: #a78bfa;

  border-radius: 50%;

  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loadingCard strong {
  font-size: 13px;
}

.loadingCard p {
  margin: 4px 0 0;

  color: #74747f;

  font-size: 11px;
}

/* =========================
   WORKSPACE
========================= */

.workspace {
  width: 100%;

  margin-top: 19px;

  padding: 21px;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      rgba(19, 19, 25, 0.96),
      rgba(10, 10, 14, 0.96)
    );

  border: 1px solid rgba(255, 255, 255, 0.065);

  border-radius: 24px;

  box-shadow:
    0 25px 80px rgba(0, 0, 0, 0.28);
}

.workspaceHeader {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 15px;
}

.projectInfo {
  display: flex;

  gap: 7px;

  margin-top: 14px;

  overflow-x: auto;

  scrollbar-width: none;
}

.projectInfo::-webkit-scrollbar {
  display: none;
}

.projectInfo span {
  flex-shrink: 0;

  padding: 7px 10px;

  border: 1px solid rgba(255, 255, 255, 0.055);

  border-radius: 999px;

  background: rgba(7, 7, 10, 0.7);

  color: #92929d;

  font-size: 10px;
}

/* =========================
   VIDEO
========================= */

.videoCard {
  width: 100%;

  margin-top: 17px;

  padding: 12px;

  border: 1px solid rgba(255, 255, 255, 0.065);

  border-radius: 19px;

  background: #08080b;
}

.videoCard video {
  display: block;

  width: min(100%, 430px);

  max-height: 72vh;

  margin: 0 auto;

  border-radius: 14px;

  background: #000;

  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.4);
}

.downloadButton {
  display: flex;

  align-items: center;
  justify-content: center;

  width: min(100%, 430px);

  min-height: 48px;

  margin: 12px auto 0;

  border: 1px solid rgba(155, 124, 255, 0.22);

  border-radius: 12px;

  background: rgba(124, 58, 237, 0.09);

  color: #d9d0ff;

  text-decoration: none;

  font-size: 12px;
  font-weight: 800;
}

/* =========================
   RESULT CARDS
========================= */

.resultCard {
  position: relative;

  margin-top: 13px;

  padding: 17px;

  border: 1px solid rgba(255, 255, 255, 0.055);

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(11, 11, 15, 0.94),
      rgba(8, 8, 11, 0.94)
    );
}

.resultTop {
  display: flex;

  align-items: flex-start;

  gap: 12px;
}

.resultEmoji {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex: 0 0 38px;

  border-radius: 11px;

  background: rgba(139, 92, 246, 0.1);

  font-size: 17px;
}

.resultLabel {
  margin-bottom: 6px;

  color: #9276ff;

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 1px;
}

.resultCard h3 {
  margin: 0;

  color: #eeeeef;

  font-size: 14px;

  line-height: 1.55;

  font-weight: 700;

  overflow-wrap: anywhere;
}

.miniCopy {
  margin-top: 12px;

  padding: 7px 10px;

  border: 1px solid rgba(255, 255, 255, 0.07);

  border-radius: 9px;

  background: #0a0a0d;

  color: #aaaab4;

  font-size: 10px;

  cursor: pointer;
}

.titleCard {
  border-color: rgba(155, 124, 255, 0.15);

  background:
    linear-gradient(
      145deg,
      rgba(91, 62, 170, 0.1),
      rgba(10, 10, 14, 0.95)
    );
}

/* =========================
   FEATURES
========================= */

.features {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 11px;

  margin-top: 17px;
}

.features > div {
  padding: 17px;

  background: rgba(12, 12, 16, 0.75);

  border: 1px solid rgba(255, 255, 255, 0.05);

  border-radius: 17px;
}

.features span {
  display: block;

  margin-bottom: 10px;

  font-size: 20px;
}

.features h3 {
  margin: 0 0 5px;

  font-size: 13px;
}

.features p {
  margin: 0;

  color: #70707b;

  font-size: 11px;

  line-height: 1.55;
}

/* =========================
   FOOTER
========================= */

.footer {
  padding: 15px 0 5px;

  text-align: center;

  color: #4f4f59;

  font-size: 10px;

  letter-spacing: 0.2px;
}

.footer strong {
  color: #8171aa;

  font-weight: 800;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 650px) {
  .navbar {
    height: 60px;
    padding: 0 14px;
  }

  .logo {
    font-size: 16px;
  }

  .logo span {
    width: 25px;
    height: 25px;
  }

  .container {
    width: calc(100% - 20px);

    padding: 38px 0 55px;
  }

  .hero {
    margin-bottom: 27px;
  }

  .badge {
    margin-bottom: 17px;

    font-size: 8px;
  }

  .hero h1 {
    font-size: clamp(39px, 12vw, 52px);

    letter-spacing: -2.7px;
  }

  .hero p {
    padding: 0 8px;

    margin-top: 16px;

    font-size: 13px;
  }

  .creatorCard {
    padding: 15px;

    border-radius: 20px;
  }

  .cardTop h2 {
    font-size: 18px;
  }

  textarea {
    min-height: 145px;

    padding: 14px;

    font-size: 15px;
  }

  .options {
    grid-template-columns: 1fr;

    gap: 10px;
  }

  select {
    height: 48px;

    font-size: 14px;
  }

  .buttonRow {
    grid-template-columns: 1fr;

    gap: 9px;
  }

  .createButton,
  .videoButton {
    min-height: 53px;
  }

  .workspace {
    padding: 14px;

    border-radius: 20px;
  }

  .workspaceHeader h2 {
    font-size: 18px;
  }

  .videoCard {
    padding: 9px;

    border-radius: 16px;
  }

  .videoCard video {
    width: 100%;

    max-height: 68vh;

    border-radius: 12px;
  }

  .resultCard {
    padding: 14px;
  }

  .resultEmoji {
    width: 34px;
    height: 34px;

    flex-basis: 34px;

    font-size: 15px;
  }

  .resultCard h3 {
    font-size: 13px;
  }

  .features {
    grid-template-columns: 1fr;
  }

  .features > div {
    padding: 15px;
  }
}

@media (min-width: 651px) {
  .creatorCard,
  .workspace {
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
}
